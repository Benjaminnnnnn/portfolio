+// Home hero inspired by Aceternity's Lamp, 3D Card and Moving Border patterns.
+import React from 'react';
+import { motion, useMotionValue, useSpring, useTransform } from 'framer-motion';
+import './splendor-hero.css';
+
+const gems = [
+  { c: '#f4f1ea', x: '54%', y: '14%', s: 34, d: 0 },
+  { c: '#3b6fe0', x: '57%', y: '74%', s: 28, d: 0.6 },
+  { c: '#1fa065', x: '86%', y: '14%', s: 34, d: 1.1 },
+  { c: '#e0245e', x: '93%', y: '60%', s: 42, d: 0.3 },
+  { c: '#2b2d33', x: '76%', y: '86%', s: 26, d: 0.9 },
+  { c: '#f5c518', x: '64%', y: '40%', s: 22, d: 1.4 },
+];
+
+const hand = [
+  { src: '/card-art/ruby-tier3.png', r: -14, x: -150, pts: 4, gem: '#e0245e' },
+  { src: '/noble-art/noble_3.png', r: 0, x: 0, pts: 3, gem: '#f5c518', noble: true },
+  { src: '/card-art/sapphire-tier2.png', r: 14, x: 150, pts: 2, gem: '#3b6fe0' },
+];
+
+export const SplendorHero: React.FC<{ onCreate: () => void; onJoin: () => void; disabled?: boolean }> = ({ onCreate, onJoin, disabled }) => {
+  const mx = useMotionValue(0), my = useMotionValue(0);
+  const rx = useSpring(useTransform(my, [-0.5, 0.5], [10, -10]), { stiffness: 120, damping: 14 });
+  const ry = useSpring(useTransform(mx, [-0.5, 0.5], [-14, 14]), { stiffness: 120, damping: 14 });
+  return (
+    <section
+      className="sp-hero"
+      onMouseMove={(e) => { const r = e.currentTarget.getBoundingClientRect(); mx.set((e.clientX - r.left) / r.width - 0.5); my.set((e.clientY - r.top) / r.height - 0.5); }}
+      onMouseLeave={() => { mx.set(0); my.set(0); }}
+    >
+      <div className="sp-lamp" aria-hidden>
+        <motion.span className="sp-cone sp-cone-l" initial={{ width: '14rem', opacity: 0.4 }} animate={{ width: '30rem', opacity: 1 }} transition={{ delay: 0.2, duration: 1, ease: 'easeInOut' }} />
+        <motion.span className="sp-cone sp-cone-r" initial={{ width: '14rem', opacity: 0.4 }} animate={{ width: '30rem', opacity: 1 }} transition={{ delay: 0.2, duration: 1, ease: 'easeInOut' }} />
+        <motion.span className="sp-beam" initial={{ width: '14rem' }} animate={{ width: '30rem' }} transition={{ delay: 0.2, duration: 1 }} />
+        <span className="sp-glow" />
+      </div>
+      {gems.map((g, i) => (
+        <motion.span
+          key={i}
+          aria-hidden
+          className="sp-gem"
+          style={{ left: g.x, top: g.y, width: g.s, height: g.s, ['--gem' as string]: g.c }}
+          animate={{ y: [0, -14, 0] }}
+          transition={{ duration: 5 + i, repeat: Infinity, ease: 'easeInOut', delay: g.d }}
+        />
+      ))}
+
+      <div className="sp-copy">
+        <motion.p className="sp-kicker" initial={{ opacity: 0, y: 12 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.4 }}>
+          Renaissance · 2–4 players · real time
+        </motion.p>
+        <motion.h1 initial={{ opacity: 0.4, y: 40 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3, duration: 0.8, ease: 'easeInOut' }}>
+          Build a jewel empire <br /> <em>before your rivals do.</em>
+        </motion.h1>
+        <motion.p className="sp-lede" initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.7 }}>
+          Collect gems, buy mines and caravans, and court the nobles. First to fifteen prestige wins.
+        </motion.p>
+        <div className="sp-ctas">
+          <button className="sp-moving-border" onClick={onCreate} disabled={disabled} data-testid="create-game-button">
+            <span className="sp-moving-border-track" aria-hidden />
+            <span className="sp-moving-border-inner">＋ Create New Game</span>
+          </button>
+          <button className="sp-ghost" onClick={onJoin} disabled={disabled} data-testid="join-invite-code-button">Join by Invite Code</button>
+        </div>
+      </div>
+
+      <motion.div className="sp-hand" style={{ rotateX: rx, rotateY: ry }}>
+        {hand.map((c, i) => (
+          <motion.figure
+            key={c.src}
+            className={`sp-card${c.noble ? ' sp-card-noble' : ''}`}
+            initial={{ opacity: 0, y: 60, rotate: 0, x: 0 }}
+            animate={{ opacity: 1, y: c.noble ? -18 : 0, rotate: c.r, x: c.x }}
+            transition={{ delay: 0.5 + i * 0.12, type: 'spring', stiffness: 90, damping: 14 }}
+            whileHover={{ y: c.noble ? -40 : -24, scale: 1.04 }}
+          >
+            <img src={c.src} alt="" />
+            <span className="sp-card-pts">{c.pts}</span>
+            <span className="sp-card-gem" style={{ ['--gem' as string]: c.gem }} />
+            <span className="sp-card-sheen" aria-hidden />
+          </motion.figure>
+        ))}
+      </motion.div>
+    </section>
+  );
+};
