+
+/* CypressHero: Aceternity-style hero highlight + container scroll */
+.cy-dots { background-image: radial-gradient(rgba(255,255,255,.09) 1px, transparent 1px); background-size: 18px 18px; mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 85%); }
+.cy-dots-lit { background-image: radial-gradient(rgba(170,130,255,.95) 1px, transparent 1px); mask-image: radial-gradient(220px circle at var(--mx, 50%) var(--my, 30%), #000, transparent 70%); }
+.cy-highlight { position: relative; display: inline-block; padding: 0 .15em; border-radius: .2em; background: linear-gradient(90deg, #6366f1, #a855f7, #ec4899) no-repeat left center / 0% 100%; animation: cy-mark 1.4s cubic-bezier(.22,1,.36,1) .6s forwards; }
+@keyframes cy-mark { to { background-size: 100% 100%; } }
+.cy-rise { opacity: 0; transform: translateY(18px); animation: cy-rise .8s cubic-bezier(.22,1,.36,1) forwards; }
+@keyframes cy-rise { to { opacity: 1; transform: none; } }
+.cy-shine::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 35%, rgba(255,255,255,.7) 50%, transparent 65%); transform: translateX(-100%); animation: cy-shine 3.5s ease-in-out 1.5s infinite; }
+@keyframes cy-shine { 40%, 100% { transform: translateX(100%); } }
+.cy-stage { perspective: 1400px; }
+.cy-device { transform: rotateX(18deg) scale(.96); transform-origin: top center; animation: cy-flatten linear both; animation-timeline: view(); animation-range: entry 0% cover 45%; }
+@keyframes cy-flatten { to { transform: rotateX(0deg) scale(1); } }
+@media (prefers-reduced-motion: reduce) { .cy-rise, .cy-highlight, .cy-shine::after, .cy-device { animation: none !important; opacity: 1; transform: none; background-size: 100% 100%; } }
