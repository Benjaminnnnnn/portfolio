+"use client";
+// Hero Highlight + Container Scroll patterns from Aceternity UI, built with
+// CSS only (no framer-motion in this project).
+import Image from "next/image";
+import Link from "next/link";
+import { useRef } from "react";
+import AppBanner from "../../../public/appBanner.png";
+
+const features = ["Accounts & sessions", "Private or shared workspaces", "Nested folders & files", "Drizzle + Postgres model"];
+
+export default function CypressHero() {
+  const ref = useRef<HTMLElement>(null);
+  return (
+    <section
+      ref={ref}
+      className="cy-hero relative isolate overflow-hidden px-4 pb-10 pt-20 sm:px-6"
+      onMouseMove={(e) => {
+        const r = e.currentTarget.getBoundingClientRect();
+        e.currentTarget.style.setProperty("--mx", `${e.clientX - r.left}px`);
+        e.currentTarget.style.setProperty("--my", `${e.clientY - r.top}px`);
+      }}
+    >
+      <div aria-hidden className="cy-dots absolute inset-0 -z-10" />
+      <div aria-hidden className="cy-dots cy-dots-lit absolute inset-0 -z-10" />
+      <div aria-hidden className="absolute left-1/2 top-24 -z-10 h-[420px] w-[820px] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,rgba(126,74,255,.45),transparent)] blur-3xl" />
+
+      <div className="mx-auto flex max-w-5xl flex-col items-center text-center">
+        <span className="cy-rise rounded-full bg-gradient-to-r from-brand-primary-blue to-brand-primary-purple p-px text-sm">
+          <span className="block rounded-full bg-black/80 px-4 py-1.5 text-white/85">✨ Notes, docs and wikis in one calm place</span>
+        </span>
+        <h1 className="cy-rise mt-7 text-5xl font-semibold leading-[1.05] tracking-[-0.035em] text-white sm:text-7xl" style={{ animationDelay: ".08s" }}>
+          Give every idea
+          <br />
+          <span className="cy-highlight">a workspace of its own.</span>
+        </h1>
+        <p className="cy-rise mt-6 max-w-2xl text-lg text-white/60" style={{ animationDelay: ".16s" }}>
+          Cypress organizes your team&apos;s documents into workspaces, folders and files — with accounts, sharing and a typed Postgres model underneath.
+        </p>
+        <div className="cy-rise mt-9 flex flex-wrap items-center justify-center gap-3" style={{ animationDelay: ".24s" }}>
+          <Link href="/signup" className="cy-shine relative overflow-hidden rounded-xl bg-white px-6 py-3.5 text-base font-semibold text-black shadow-[0_20px_60px_-15px_rgba(126,74,255,.9)]">
+            Create your workspace
+          </Link>
+          <Link href="/login" className="rounded-xl border border-white/15 bg-white/5 px-6 py-3.5 text-base font-semibold text-white backdrop-blur hover:border-white/30">
+            Sign in
+          </Link>
+        </div>
+        <ul className="cy-rise mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-white/50" style={{ animationDelay: ".32s" }}>
+          {features.map((f) => (
+            <li key={f} className="flex items-center gap-2"><span className="h-1.5 w-1.5 rounded-full bg-brand-primary-purple" />{f}</li>
+          ))}
+        </ul>
+      </div>
+
+      <div className="cy-stage mx-auto mt-16 max-w-6xl">
+        <div className="cy-device rounded-[28px] border border-white/10 bg-[#0d0b16] p-3 shadow-[0_0_0_1px_rgba(255,255,255,.04),0_60px_140px_-40px_rgba(126,74,255,.65)]">
+          <div className="overflow-hidden rounded-[20px] border border-white/5">
+            <Image src={AppBanner} alt="Cypress workspace with sidebar navigation" priority className="w-full" />
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
