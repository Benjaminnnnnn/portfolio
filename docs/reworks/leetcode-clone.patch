+"use client";
+// Hero for the problem list. Background Beams + Bento Grid + Infinite Moving
+// Cards, adapted from Aceternity UI (ui.aceternity.com).
+import { DBProblem } from "@/utils/types/problem";
+import { motion } from "framer-motion";
+import Link from "next/link";
+
+const beams = [
+  "M-380 -189C-380 -189 -312 216 152 343C616 470 684 875 684 875",
+  "M-338 -237C-338 -237 -270 168 194 295C658 422 726 827 726 827",
+  "M-296 -285C-296 -285 -228 120 236 247C700 374 768 779 768 779",
+  "M-254 -333C-254 -333 -186 72 278 199C742 326 810 731 810 731",
+  "M-212 -381C-212 -381 -144 24 320 151C784 278 852 683 852 683",
+  "M-170 -429C-170 -429 -102 -24 362 103C826 230 894 635 894 635",
+  "M-128 -477C-128 -477 -60 -72 404 55C868 182 936 587 936 587",
+  "M-86 -525C-86 -525 -18 -120 446 7C910 134 978 539 978 539",
+];
+
+const BackgroundBeams = () => (
+  <svg className="pointer-events-none absolute inset-0 h-full w-full" viewBox="0 0 696 316" fill="none" preserveAspectRatio="xMidYMid slice" aria-hidden>
+    <defs>
+      <linearGradient id="beam" x1="0" x2="1" y1="0" y2="1">
+        <stop stopColor="#ffa116" stopOpacity="0" />
+        <stop offset=".35" stopColor="#ffa116" />
+        <stop offset=".6" stopColor="#ff4d8d" />
+        <stop offset="1" stopColor="#7c5cff" stopOpacity="0" />
+      </linearGradient>
+    </defs>
+    {beams.map((d, i) => (
+      <g key={i}>
+        <path d={d} stroke="rgba(255,255,255,.05)" strokeWidth=".6" />
+        <path
+          d={d}
+          stroke="url(#beam)"
+          strokeWidth="1"
+          strokeLinecap="round"
+          strokeDasharray="60 1340"
+          className="arena-anim"
+          style={{ animation: `beam-dash ${7 + (i % 4) * 1.6}s linear ${i * 0.7}s infinite` }}
+        />
+      </g>
+    ))}
+  </svg>
+);
+
+const tone = {
+  Easy: { text: "text-teal-300", bar: "from-teal-400 to-emerald-300", glow: "shadow-[0_0_40px_-12px_rgba(45,212,191,.8)]" },
+  Medium: { text: "text-amber-300", bar: "from-amber-400 to-orange-400", glow: "shadow-[0_0_40px_-12px_rgba(251,191,36,.8)]" },
+  Hard: { text: "text-rose-300", bar: "from-rose-500 to-pink-400", glow: "shadow-[0_0_40px_-12px_rgba(244,63,94,.8)]" },
+} as const;
+
+export default function ArenaHero({ problems }: { problems: DBProblem[] }) {
+  const counts = (["Easy", "Medium", "Hard"] as const).map((d) => ({ d, n: problems.filter((p) => p.difficulty === d).length }));
+  const categories = Array.from(new Set(problems.map((p) => p.category)));
+  const total = problems.length || 1;
+  const daily = problems.find((p) => p.id === "number-of-islands") ?? problems[0];
+
+  return (
+    <section className="relative mx-auto mb-10 w-full max-w-screen-2xl px-4 sm:px-6">
+      <div className="relative overflow-hidden rounded-[28px] border border-white/10 bg-[radial-gradient(120%_80%_at_0%_0%,#1d1408_0%,#0b0a10_45%,#07070b_100%)] px-8 py-14 sm:px-14">
+        <BackgroundBeams />
+        <div className="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-orange-500/20 blur-[120px]" />
+        <div className="relative grid gap-10 lg:grid-cols-[1.25fr_1fr] lg:items-end">
+          <motion.div initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.7 }}>
+            <span className="inline-flex items-center gap-2 rounded-full border border-orange-300/20 bg-orange-400/10 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.2em] text-orange-200">
+              <span className="h-1.5 w-1.5 animate-pulse rounded-full bg-orange-400" /> {problems.length} problems · JS judge in the browser
+            </span>
+            <h1 className="mt-6 text-5xl font-semibold leading-[1.02] tracking-[-0.045em] text-white sm:text-6xl">
+              Read it. Write it.
+              <br />
+              <span className="bg-gradient-to-r from-[#ffa116] via-[#ff6b6b] to-[#b18cff] bg-clip-text text-transparent">Pass every case.</span>
+            </h1>
+            <p className="mt-5 max-w-xl text-base leading-relaxed text-white/60">
+              A focused interview-prep workspace: problem, editor and test cases side by side, with walkthrough videos when you get stuck.
+            </p>
+            <div className="mt-8 flex flex-wrap gap-3">
+              <Link href={`/problems/${daily?.id ?? "two-sum"}`} className="group relative inline-flex items-center gap-2 overflow-hidden rounded-xl bg-[#ffa116] px-5 py-3 text-sm font-semibold text-black shadow-[0_10px_40px_-10px_rgba(255,161,22,.8)]">
+                <span className="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/50 to-transparent transition-transform duration-700 group-hover:translate-x-full" />
+                Solve today&apos;s problem →
+              </Link>
+              <Link href="/playground" className="inline-flex items-center rounded-xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white backdrop-blur hover:border-white/30">
+                Open playground
+              </Link>
+            </div>
+          </motion.div>
+
+          <div className="grid grid-cols-3 gap-3">
+            {counts.map(({ d, n }, i) => (
+              <motion.div
+                key={d}
+                initial={{ opacity: 0, y: 24 }}
+                animate={{ opacity: 1, y: 0 }}
+                transition={{ delay: 0.2 + i * 0.1 }}
+                className={`rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur ${tone[d].glow}`}
+              >
+                <p className={`font-mono text-[11px] uppercase tracking-[0.18em] ${tone[d].text}`}>{d}</p>
+                <p className="mt-3 text-4xl font-semibold tracking-tight text-white">{n}</p>
+                <div className="mt-4 h-1.5 overflow-hidden rounded-full bg-white/10">
+                  <motion.div className={`h-full rounded-full bg-gradient-to-r ${tone[d].bar}`} initial={{ width: 0 }} animate={{ width: `${(n / total) * 100}%` }} transition={{ delay: 0.5 + i * 0.1, duration: 0.9 }} />
+                </div>
+              </motion.div>
+            ))}
+            {daily && (
+              <Link href={`/problems/${daily.id}`} className="col-span-3 flex items-center justify-between rounded-2xl border border-orange-300/20 bg-gradient-to-r from-orange-500/15 via-pink-500/10 to-violet-500/10 p-4 transition hover:border-orange-300/40">
+                <div>
+                  <p className="font-mono text-[11px] uppercase tracking-[0.18em] text-orange-200/80">Daily challenge</p>
+                  <p className="mt-1 text-lg font-semibold text-white">{daily.title}</p>
+                </div>
+                <span className="rounded-full bg-black/40 px-3 py-1 text-xs text-amber-300">{daily.difficulty} · {daily.category}</span>
+              </Link>
+            )}
+          </div>
+        </div>
+
+        <div className="relative mt-12 overflow-hidden [mask-image:linear-gradient(to_right,transparent,#000_10%,#000_90%,transparent)]">
+          <div className="arena-anim flex w-max gap-3" style={{ animation: "arena-marquee 40s linear infinite" }}>
+            {[...categories, ...categories].map((c, i) => (
+              <span key={i} className="whitespace-nowrap rounded-full border border-white/10 bg-white/[0.03] px-4 py-1.5 text-sm text-white/70">{c}</span>
+            ))}
+          </div>
+        </div>
+      </div>
+    </section>
+  );
+}
