+/* Aurora theme — a dark, luminous skin over the existing Tailwind classes. */
+:root {
+  --ink-0: #05040d;
+  --ink-1: #0b0a18;
+  --ink-2: #121027;
+  --ink-3: #1b1838;
+  --line: rgba(167, 139, 250, 0.14);
+  --line-strong: rgba(167, 139, 250, 0.28);
+  --text-0: #f4f1ff;
+  --text-1: #c9c2e8;
+  --text-2: #8e87b3;
+}
+
+body.aurora {
+  background: radial-gradient(1200px 600px at 20% -10%, rgba(124, 58, 237, 0.22), transparent 60%),
+    radial-gradient(900px 500px at 110% 10%, rgba(34, 211, 238, 0.12), transparent 60%), var(--ink-0);
+  color: var(--text-1);
+  font-family: "Geist", "Inter", ui-sans-serif, system-ui, sans-serif;
+}
+
+.aurora .bg-white, .aurora .bg-white\/90 { background-color: rgba(18, 16, 39, 0.72) !important; backdrop-filter: blur(14px); }
+.aurora .bg-slate-50, .aurora .bg-slate-50\/50 { background-color: rgba(11, 10, 24, 0.55) !important; }
+.aurora .bg-slate-100 { background-color: rgba(27, 24, 56, 0.9) !important; }
+.aurora .bg-slate-200, .aurora .bg-slate-200\/50 { background-color: rgba(167, 139, 250, 0.12) !important; }
+.aurora .bg-brand-50, .aurora .bg-brand-50\/80 { background-color: rgba(139, 92, 246, 0.16) !important; }
+.aurora .bg-brand-100 { background-color: rgba(139, 92, 246, 0.28) !important; }
+.aurora .bg-amber-50 { background-color: rgba(251, 191, 36, 0.1) !important; }
+.aurora .bg-rose-50 { background-color: rgba(244, 63, 94, 0.1) !important; }
+.aurora .bg-slate-900 { background: linear-gradient(135deg, #7c3aed, #22d3ee) !important; }
+
+.aurora .border-slate-100, .aurora .border-slate-200, .aurora .border-slate-300,
+.aurora .border-brand-100, .aurora .border-brand-200 { border-color: var(--line) !important; }
+.aurora .ring-slate-100, .aurora .ring-black\/5, .aurora .ring-black\/10, .aurora .ring-brand-100 { --tw-ring-color: var(--line) !important; }
+
+.aurora .text-slate-900, .aurora .text-slate-800 { color: var(--text-0) !important; }
+.aurora .text-slate-700, .aurora .text-slate-600 { color: var(--text-1) !important; }
+.aurora .text-slate-500, .aurora .text-slate-400 { color: var(--text-2) !important; }
+.aurora .text-brand-600, .aurora .text-brand-700 { color: #c4b5fd !important; }
+
+.aurora .shadow-sm, .aurora .shadow-md, .aurora .shadow-lg { box-shadow: 0 10px 40px -20px rgba(124, 58, 237, 0.55) !important; }
+
+.aurora nav { background: rgba(5, 4, 13, 0.6) !important; backdrop-filter: blur(18px) saturate(1.4); border-color: var(--line) !important; }
+
+/* Pathfinding grid: cells become glowing tiles. */
+.aurora .grid .bg-slate-800 { background: linear-gradient(160deg, #2a2456, #16132f) !important; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06); }
+.aurora .grid .bg-emerald-400 { background: #34d399 !important; box-shadow: 0 0 18px rgba(52, 211, 153, 0.8), 0 0 42px rgba(52, 211, 153, 0.35) !important; }
+.aurora .grid .bg-emerald-500 { box-shadow: 0 0 24px rgba(16, 185, 129, 0.9) !important; }
+.aurora .grid .bg-rose-500 { box-shadow: 0 0 24px rgba(244, 63, 94, 0.9) !important; }
+.aurora .grid .bg-amber-400 { box-shadow: 0 0 26px rgba(251, 191, 36, 0.95) !important; }
+
+.scrollbar-hide::-webkit-scrollbar { display: none; }
+.scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
+
+@keyframes meteor { 0% { transform: rotate(215deg) translateX(0); opacity: 1; } 70% { opacity: 1; } 100% { transform: rotate(215deg) translateX(-600px); opacity: 0; } }
+@keyframes spotlight { 0% { opacity: 0; transform: translate(-72%, -62%) scale(0.5); } 100% { opacity: 1; transform: translate(-50%, -40%) scale(1); } }
+@keyframes shimmer { from { background-position: 0 0; } to { background-position: -200% 0; } }
+@media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
+
+.aurora .grid .bg-slate-800 { background: linear-gradient(160deg, #6d5bd0, #3b2f86) !important; box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 6px 18px -8px rgba(109,91,208,.8) !important; }
+.aurora .grid .bg-slate-50 { background: rgba(255,255,255,.025) !important; border-color: rgba(167,139,250,.08) !important; }
+.aurora .grid .bg-brand-100 { background: rgba(34,211,238,.18) !important; border-color: rgba(103,232,249,.35) !important; box-shadow: 0 0 14px -2px rgba(34,211,238,.45); }
+.aurora .prose, .aurora .prose p, .aurora .prose em { color: var(--text-1) !important; } .aurora .prose strong { color: var(--text-0) !important; }
